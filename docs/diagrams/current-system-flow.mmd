  I --> J["历史消息摘要/意图识别/标签补充"]
  J --> B

  B --> T1["电销运营"]
  T1 --> T2["电销分析 Agent"]
  T2 --> T3["客户分层<br/>高意向/培育/低活跃"]
  T3 --> T4["推荐群发批次<br/>名单/筛选条件/排除原因/文案"]
  T4 --> T5["人工审批"]
  T5 --> T6["系统控制企微后台<br/>创建群发任务"]
  T6 --> T7["员工执行群发"]
  T7 --> H

  B --> S1["销售运营"]
  S1 --> S2["销售承接 Agent"]
  S2 --> S3["客户意向判断<br/>会员卡/报价/异议/付款/暂缓"]
  S3 --> S4["销售任务队列<br/>优先级/原因/SLA/负责人"]
  S3 --> S5["销售辅助信息<br/>客户摘要/关键历史记录/推荐回复"]
  S4 --> S6["企微应用/侧边栏"]
  S5 --> S6
  S6 --> S7["销售人工查看并回复客户"]
  S7 --> H

  B --> V1["VIP群维护"]
  W1["企微客户端未读消息"] --> W2["本地企微 Worker<br/>识别未读/读取新消息"]
  W2 --> W3["标准入站消息<br/>roomId/messageId/sender/text"]
  W3 --> V1
  V1 --> V2["VIP分流 Agent"]
  V2 --> V3["识别问题类型<br/>售前/售后/报价/投诉/财务"]
  V3 --> V4{"风险判断"}
  V4 -->|"低风险"| V5["自动回复队列<br/>SendScheduler"]
  V4 -->|"高风险"| V6["人工确认"]
  V6 --> V5
  V5 --> V7["发送前防漏读校验"]
  V7 -->|"仍匹配触发消息"| V8["企微员工客户端自动化发送"]
  V7 -->|"发现新消息/员工已回复"| V9["取消旧回复<br/>新消息重新入站"]
  V9 --> V2
  V8 --> V10["本地动作回执"]
  V10 --> V11["历史消息补账确认"]
  V11 --> H

  T5 --> Q["任务与审批中心"]
  S4 --> Q
  V6 --> Q
  Q --> Q1["任务状态更新<br/>跟进/完成/转交/升级"]
  Q1 --> B

  CFG["系统设置<br/>模型配置/企微状态/历史消息/模板风控/系统自检"] --> T2
  CFG --> S2
  CFG --> V2
  B --> LOG["审计日志/客户事件/任务记录"]
  Q1 --> LOG
  V11 --> LOG
